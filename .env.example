# Application
PORT=3000

# Database (Development)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce?schema=public"

# Database (Testing — sample for .env.test pointing to commerce_test)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/commerce_test?schema=public"

# Database credentials for docker-compose (optional overrides)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=commerce
DB_PORT=5432
