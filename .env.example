# ==============================================================================
# NestJS Commerce Engine — Environment Configuration Template
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port (1-65535)
PORT=3000

# API Version prefix (e.g. v1)
API_VERSION=v1

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce?schema=public"

# Database Connection for Testing (used in .env.test)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/commerce_test?schema=public"

# Database credentials for docker-compose (optional overrides)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=commerce
DB_PORT=5432

# Authentication & Security
# SECRET_KEY must be a cryptographically strong secret string (minimum 32 characters in production)
SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars

# Token Expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Inventory Reservation TTL (minutes)
RESERVATION_TTL_MINUTES=15

# Default Currency Code (ISO 4217, e.g. VND, USD)
DEFAULT_CURRENCY=VND

# Default Tax Rate in Percentage (e.g. 8.0 for 8% VAT)
TAX_RATE_PERCENT=8.0

# CORS Allowed Origins (comma-separated origins or * for all)
ALLOWED_ORIGINS=*

# Storefront cache TTL in seconds (0 disables). The in-memory store is per process:
# with several instances use a shared (Redis) store instead.
STOREFRONT_CACHE_TTL_SECONDS=30

# Print every SQL statement Prisma runs to the server console (local debugging only)
LOG_SQL=false

# Login brute-force guard (per client IP): max attempts per window
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# First admin account, created at startup when BOTH are set (leave empty to skip).
# Change the password after the first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
